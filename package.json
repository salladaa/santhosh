{
  "name": "hospital-portal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write app components lib types tests scripts docs README.md package.json next.config.ts",
    "format:check": "prettier --check app components lib types tests scripts docs README.md package.json next.config.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "postbuild": "node scripts/package-standalone.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
