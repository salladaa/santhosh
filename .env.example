# Copy to .env.local for local configuration; never commit the filled file.
PORTAL_DEMO=false
PORTAL_DB_PATH=.portal/hospital.sqlite
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
# Public HTTPS origin; no trailing slash.
PORTAL_ORIGIN=
# Separate 32-byte (64 hex character) keys. Keep them in a secret manager.
PORTAL_REPORT_KEY=
PORTAL_BACKUP_KEY=
PORTAL_BACKUP_DIR=.portal/backups
# Docker Compose / Caddy deployment only; e.g. portal.yourhospital.in
PORTAL_DOMAIN=
